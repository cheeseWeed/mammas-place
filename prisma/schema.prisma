// Prisma schema for the Utah Driver License multi-user progress store.
// Backed by Neon Postgres in prod, can use a local Postgres in dev.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// One row per registered learner.
//
// Originally created for the Driver License study tool (hence the table name
// `drive_users` and the legacy Drive-specific JSON blobs at the top), but now
// acts as the shared LearnerProfile across every learning section in the app
// (Drive, Geography, Spelling, ...). New sections add a JSONB column for
// their per-user progress; profile fields (age, grade, displayName) sit at
// the row level so all sections can read/write them through one place.
//
// Bulk fields stay as JSONB for simplicity — small data per user (under a
// few KB each), no need to normalize.
model DriveUser {
  name             String   @id // normalized lowercase username
  pinHash          String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // ----- Drive (Utah Driver License study) -----
  attempts         Json     @default("[]") // QuizAttempt[]
  misses           Json     @default("[]") // string[]
  unitScores       Json     @default("{}") // Record<string, UnitScore>
  sr               Json     @default("{}") // Record<string, SrRecord>
  mode             String?  // 'quick' | 'deep' | null
  deckCompletions  Json     @default("{}") // Record<string, number>

  // ----- Shared learner profile (all sections) -----
  ageYears         Int?     // optional — collected at registration or settings
  gradeLevel       String?  // "preschool" | "K" | "1".."12"
  displayName      String?  // pretty-cased name for UI; falls back to `name`

  // ----- Family / chores (Family Chores section) -----
  // `isParent` is granted by the app Admin. A parent can create/edit their
  // family's chore chart, invite members, take points, and see the redeem log.
  // `familyId` is the family this user belongs to (parent or member). Null = not
  // in a family yet. A family can have multiple parents (mom AND dad). See
  // app/chores/PLAN.md + lib/family/.
  isParent         Boolean  @default(false)
  familyId         String?
  family           Family?  @relation(fields: [familyId], references: [id])

  // ----- Per-section progress blobs -----
  // Spelling: { level: number, attempts: SpellingAttempt[], misses: string[], lastSession?: number, ... }
  spelling         Json     @default("{}")
  // Geography: { phases: Record<string, unknown>, lastActive?: number, ... }
  // Currently opt-in — Geography defaults to anonymous localStorage.
  geography        Json     @default("{}")
  // Math: { roundsPlayed: number, bestStreak: number, lastSession?: number, history: MathRound[], ... }
  math             Json     @default("{}")
  // Language Arts: { homophones: {...}, grammar: {...}, ..., lastSession?: number }
  languageArts     Json     @default("{}")
  // Chess: { current?: SavedChessGame, recentGames: SavedChessGame[], totals: {...}, ... }
  // Shape defined in lib/chess/game-state.ts (ChessProgress).
  chess            Json     @default("{}")
  // Music: practice tracker for any instrument. Shape (MusicProfile) defined
  // in lib/music/types.ts: { pieces: MusicPiece[], challenge?: MusicChallenge }.
  // Each piece carries its title/instrument/estLines/targetDate, a per-day
  // log of quality scores (1-10), and a passedOffAt stamp once mastered.
  // Daily practice earns MP through /api/music/practice (own earn path, like
  // chess games) but still writes section='music' MpEarning rows so the
  // wallet grid totals it. See app/music/PLAN.md.
  music            Json     @default("{}")
  // Audiobook listen history keyed by product id.
  // Shape: Record<productId, { lastListenedAt: number, completed: boolean }>
  // See lib/audiobooks.ts for read/write helpers.
  audioHistory     Json     @default("{}")
  // "Up next" pointer per series — Record<series, productId> of the next
  // un-completed item in that series. Updated by markListenComplete when an
  // episode finishes; lets the homepage build "Continue listening" without
  // scanning every audiobook.
  seriesProgress   Json     @default("{}")

  // ----- MP Money (closed-loop family economy) -----
  // Balance kept in cents to avoid float drift. See app/money/PLAN.md.
  balanceCents     Int      @default(0)
  // Phase 6a: MP account card. Short 4-digit suffix unique per kid, used as a
  // receive-only identifier (grandparents can credit it, but spending still
  // requires the kid's PIN). Null until first issued. See PLAN-Phase6-Cards.md.
  mpCardNumber     String?  @unique
  mpCardCreatedAt  DateTime?
  transactions     MpTransaction[]
  orders           MpOrder[]
  earnings         MpEarning[]
  dadAsks          DadAsk[]
  imagePurchases   ImagePurchase[]

  @@map("drive_users")
}

// Append-only ledger. Every credit/debit is a row; balance on DriveUser is the
// running total. Never mutate; reversals create a new row with negated cents.
model MpTransaction {
  id        String   @id @default(cuid())
  userName  String
  user      DriveUser @relation(fields: [userName], references: [name], onDelete: Cascade)
  cents     Int      // positive = credit, negative = debit
  type      String   // 'earn' | 'spend' | 'gift' | 'refund' | 'adjust'
  reason    String
  orderId   String?
  createdAt DateTime @default(now())

  @@index([userName, createdAt])
  @@map("mp_transactions")
}

// Closed-loop "order" — no shipping, no payment processor. items is a snapshot
// of the cart at purchase time so price changes don't rewrite history.
model MpOrder {
  id          String   @id @default(cuid())
  userName    String
  user        DriveUser @relation(fields: [userName], references: [name], onDelete: Cascade)
  items       Json     // [{ productId, name, qty, priceCents }]
  totalCents  Int
  status      String   @default("fulfilled") // 'fulfilled' | 'cancelled' | 'pending'
  createdAt   DateTime @default(now())

  @@index([userName, createdAt])
  @@map("mp_orders")
}

// Digital image store — one row per OWNED COPY.
//
// ONE ROW = ONE COPY. This is the load-bearing decision of the whole model, and
// it changed in the "everything I buy is in my collection" revision. Previously
// there was a `@@unique([userName, imageId])` and a kid could hold at most one
// copy of a picture forever. The owner wants to buy three tires and own three
// tires, so that unique is GONE and a kid may now hold N rows for one imageId.
//
// WHY N ROWS AND NOT A `quantity` COLUMN. `editionNumber` is the identity of a
// SINGLE serial — "you hold copy #1 of 6". A row carrying `quantity: 3` would
// be claiming three copies that all share one serial, which makes
// @@unique([imageId, editionNumber]) decorative rather than meaningful and
// makes "trade away just one of my three" unrepresentable. It would also break
// lib/image-store/trade.ts, which moves a copy by UPDATING one row's userName
// precisely so the edition number travels with the copy. One row per copy keeps
// every one of those properties intact: each row still holds exactly one serial,
// the edition unique still arbitrates numbering, and a trade still moves exactly
// one copy.
//
// WHAT REPLACES THE DELETED DUPLICATE-BUY GATE. Removing a unique without
// replacing it would leave a double-tapped Buy button free to create two rows
// and charge twice — the exact bug the old constraint existed to stop. So the
// gate is not deleted, it is RE-AIMED: `grantKey @unique` below. The rule is now
// "one row per PURCHASE EVENT" instead of "one row per kid per picture", which
// is what we actually meant all along. Buying a second copy deliberately is a
// different event and gets a different key; double-submitting ONE click is the
// same event and collides. Same principle as MpEarning.idempotencyKey: the DB
// constraint is the gate, never a prior read.
//
// `imageId` references data/image-store.json (the catalog is a static file, not
// a table), so there is no FK here — but the catalog id is the server's source
// of truth for price. `pricePaidCents` snapshots what was actually charged so
// a later price change never rewrites history (same rule as MpOrder.items).
// `editionNumber` is the ROOKIE NUMBER: 1 for the first copy of this image ever
// sold, 2 for the second, and so on. It is derived from purchase ORDER, it is
// permanent, and it cannot be forged — the client never sends it and the server
// never trusts a count.
//
// `@@unique([imageId, editionNumber])` is what makes it RACE-SAFE, and it is
// the only thing that does. Counting existing rows and writing `count + 1` is
// a check-then-act race: two kids buying the same picture at the same instant
// both read 0 and both write #1. Postgres READ COMMITTED gives that SELECT no
// lock and no protection. Instead the INSERT itself is the arbiter — the loser
// of the race violates this constraint, gets P2002, and retries with the next
// number (lib/image-store/purchase.ts). Two rows can never share a number
// because the database will not physically store them.
//
// This is the same principle as MpEarning.idempotencyKey and grantKey below:
// the DB constraint is the gate, never a prior read.
model ImagePurchase {
  id             String   @id @default(cuid())
  userName       String
  user           DriveUser @relation(fields: [userName], references: [name], onDelete: Cascade)
  imageId        String   // catalog id from data/image-store.json, e.g. "arch-ball-001"
  pricePaidCents Int      // what the kid actually paid, snapshotted at purchase
  editionNumber  Int      @default(1) // 1 = the rookie, the first ever sold
  createdAt      DateTime @default(now())

  // HOW THIS COPY CAME TO BE OWNED. Display honesty, not a gate.
  //
  // 'store'  — bought outright in the image store for `pricePaidCents`.
  // 'grant'  — came free WITH a shop purchase (you bought the tire, so the
  //            tire's artwork is yours). pricePaidCents is legitimately 0 here.
  // 'trade'  — arrived via lib/image-store/trade.ts. Never written at creation;
  //            reserved so a future trade can restamp provenance if we want it.
  //
  // This column exists because the collection page had a real bug: a granted
  // piece rendered "Bought Jun 16, 2026 for 0MP", which reads to a kid as "this
  // is worthless". A 0 in pricePaidCents is ambiguous on its own — it could be a
  // free grant or a broken charge — so the honest answer has to be STORED at
  // write time rather than guessed from the price at read time.
  source         String   @default("store")

  // The MpOrder this copy was granted from, for 'grant' rows. Null for a store
  // buy. Lets the collection say "From your shop purchase" and lets the backfill
  // script tell an already-granted order from an ungranted one.
  grantOrderId   String?

  // THE DOUBLE-SUBMIT GATE, and the replacement for the deleted
  // @@unique([userName, imageId]).
  //
  // Identifies the PURCHASE EVENT that produced this copy, not the copy itself:
  //   store buy  -> "store:<user>:<imageId>:<cuid>"  (unique per click)
  //   shop grant -> "order:<orderId>:<imageId>:<n>"  (n = 1..qty within the order)
  //
  // The grant form is the one that matters. It is DERIVED ENTIRELY FROM THE
  // ORDER — no random component — so replaying the same order (a retried
  // checkout, a re-run of the backfill script, two concurrent reads of the same
  // order) proposes the exact same keys and collides on every one of them
  // instead of minting a second pile of free artwork. That is what makes both
  // the checkout hook and scripts/backfill-collection-grants.ts idempotent
  // WITHOUT either of them doing a findFirst-then-create, which is the
  // check-then-act race this codebase refuses everywhere else.
  //
  // Nullable because the 6 rows already in production predate the column and
  // Postgres permits many NULLs under a unique index. Those legacy rows are
  // therefore un-keyed, which is correct: they were one-time hand-backfilled
  // grants and there is no future event that could duplicate them.
  grantKey       String?  @unique

  @@unique([imageId, editionNumber])
  @@index([userName, createdAt])
  @@index([imageId])
  @@index([userName, imageId])
  @@map("image_purchases")
}

// Kid-to-kid TRADE of store-bought artwork. ONE mechanism, two shapes:
//
//   * SWAP — an image for an image. Both sides name an ImagePurchase they own.
//   * SALE — an image for MP. `offeredImageId` moves, `askCents` moves back.
//
// A sale is just a trade with MP on one side, so there is exactly one accept
// path, one transaction, and one set of race guards. Nothing here is uploadable:
// BOTH sides must already be ImagePurchase rows (bought in the store), because
// the entitlement is what is being moved.
//
// WHAT ACCEPT DOES, ATOMICALLY (lib/image-store/trade.ts acceptTrade):
//   1. flips this row 'pending' -> 'accepted' with an updateMany GUARDED on
//      `status: 'pending'` — that guarded flip is the double-accept gate and
//      the simultaneous-accept gate. `count !== 1` means somebody else already
//      resolved it, and we roll back.
//   2. MOVES the entitlement by UPDATING ImagePurchase.userName. Updating rather
//      than delete+create is deliberate: the row keeps its `editionNumber`, so
//      THE EDITION NUMBER TRAVELS WITH THE IMAGE. If Shepherd trades away
//      Edition #1, the recipient now holds Edition #1. That is the whole point
//      of a rookie card — it is a property of the copy, not of the kid.
//      The move is a guarded updateMany too (`where: { id, userName: giver }`),
//      so a stale offer (the piece was already traded away) matches 0 rows.
//   3. moves MP with the house guarded-updateMany sufficiency pattern
//      (lib/money/balance.ts) and writes an MpTransaction row for EACH side.
//
// STATUS is the state machine: 'pending' -> 'accepted' | 'declined' |
// 'cancelled' | 'blocked'. Only 'pending' is live. 'blocked' means a parent
// must approve it first (see TRADE_APPROVAL_THRESHOLD_CENTS in trade.ts) —
// it is NOT acceptable until an admin flips it back to 'pending'.
//
// There is deliberately NO unique constraint pairing a trade to an image: two
// pending offers for the same piece are legal and expected (two siblings can
// both want it). The one that is accepted FIRST wins, and the loser's accept
// finds the entitlement gone and fails on the guarded move in step 2 — which is
// exactly the stale-offer case. A read-then-write would let both "succeed".
model ImageTrade {
  id             String   @id @default(cuid())
  // Who proposed. Normalized dl_user. Never taken from a request body.
  proposerUser   String
  // Who must confirm. Normalized dl_user. Must differ from proposerUser —
  // self-trading is refused at propose time (a kid cannot mint MP by swapping
  // with themselves, and a self-swap would deadlock on the entitlement move).
  recipientUser  String

  // The piece the PROPOSER is giving up. Always present — every trade has an
  // image on the proposer's side. Catalog id from data/image-store.json.
  offeredImageId String
  // The piece the proposer wants BACK. Null for a SALE (they want MP instead).
  wantedImageId  String?
  // MP the proposer is ASKING FOR, in cents. 0 for a pure swap. Positive means
  // the recipient pays this much. Never negative — a kid cannot ask to be paid
  // to take something, and a negative here would invert the debit.
  askCents       Int      @default(0)

  // 'pending' | 'accepted' | 'declined' | 'cancelled' | 'blocked'
  status         String   @default("pending")
  // Kid's note: "I really want your unicorn!"
  note           String?
  // Set when the trade resolves, whichever way.
  resolvedAt     DateTime?
  // Snapshot of the edition numbers that actually moved, written at accept time
  // so the history page can say "you got Edition #1" without re-deriving it
  // from rows that have since moved on again.
  offeredEditionNumber Int?
  wantedEditionNumber  Int?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // The two inbox/outbox queries a kid makes, and the parent's ledger view.
  @@index([recipientUser, status, createdAt])
  @@index([proposerUser, status, createdAt])
  @@index([status, createdAt])
  @@map("image_trades")
}

// Kid-earned MP from learning sections. Idempotency key prevents the same
// round/quiz from crediting twice on accidental re-submit. `cents` is what
// the server computed (kid client cannot dictate it).
model MpEarning {
  id           String   @id @default(cuid())
  userName     String
  user         DriveUser @relation(fields: [userName], references: [name], onDelete: Cascade)
  section      String   // 'math' | 'languageArts' | 'spelling' | 'geography' | 'drive' | 'chess' | 'music'
  kind         String   // section-defined: e.g. 'math.round', 'spelling.quiz', 'drive.deck', 'music.practice'
  cents        Int      // always positive
  idempotencyKey String @unique
  meta         Json?    // {score, total, streak, ...} for debugging
  createdAt    DateTime @default(now())

  @@index([userName, createdAt])
  @@index([userName, section])
  @@map("mp_earnings")
}

// Singleton row holding the parent's admin PIN (hashed). First /api/money/parent/setup
// POST seeds it; after that, currentPin required to change.
model ParentConfig {
  id            Int      @id @default(1)
  parentPinHash String
  updatedAt     DateTime @updatedAt

  @@map("mp_parent_config")
}

// Singleton site-wide config. One row (id=1), same pattern as ParentConfig.
// `disabledSections` is a JSON string[] of learning-section keys (see
// lib/sections.ts) that an admin has turned OFF site-wide. A disabled section
// shows kids a friendly "being updated" message instead of the content; an
// admin can still preview it. Empty array = everything on (the default).
model SiteConfig {
  id               Int      @id @default(1)
  disabledSections Json     @default("[]") // string[] of section keys that are OFF
  updatedAt        DateTime @updatedAt

  @@map("site_config")
}

// "Ask Dad" — automated server-side Dad persona. Kid asks for MP with a reason;
// server scores reason quality + ask cadence + amount and rolls a weighted die
// to pick an outcome bucket. Reply text is picked from a per-bucket bank in
// lib/money/dad.ts. Not a real human — no admin queue, no parent approval.
model DadAsk {
  id            String   @id @default(cuid())
  userName      String
  user          DriveUser @relation(fields: [userName], references: [name], onDelete: Cascade)
  centsAsked    Int
  reason        String
  outcome       String   // 'yes_full' | 'yes_partial' | 'pickup_tab' | 'maybe_later' | 'no' | 'bad_luck'
  centsGranted  Int      @default(0)
  dadReply      String
  context       String   @default("portal") // 'portal' | 'checkout'
  createdAt     DateTime @default(now())

  @@index([userName, createdAt])
  @@map("mp_dad_asks")
}

// Admin-editable product catalog. Originally lived as a static JSON file
// (data/products.json) shipped at build time; promoted to the DB so the
// MP Bank admin dashboard can edit products without a redeploy.
//
// Field shape mirrors lib/types.Product. `priceCents` and `originalPriceCents`
// are stored as integers to avoid float drift (same pattern as MP balances).
// JSON columns hold the loosely-typed arrays (tags, images, reviews).
model Product {
  id                  String   @id // matches the legacy string ids ("pony-001", etc.)
  name                String
  priceCents          Int
  originalPriceCents  Int?     // null = no strikethrough
  discount            Int      @default(0) // percentage, 0..100
  description         String
  shortDescription    String
  category            String
  subcategory         String?
  tags                Json     @default("[]")   // string[]
  imageUrl            String
  images              Json     @default("[]")   // string[]
  inStock             Boolean  @default(true)
  stockCount          Int      @default(0)
  rating              Float    @default(0)
  reviewCount         Int      @default(0)
  isSale              Boolean  @default(false)
  isFeatured          Boolean  @default(false)
  isComingSoon        Boolean  @default(false)
  availableOnWebsite  Boolean  @default(true)
  sku                 String   @unique
  audioPreviewUrl     String?
  isAudiobook         Boolean  @default(false)
  isStudyGuide        Boolean  @default(false)
  studyGuideUrl       String?
  downloadUrl         String?
  reviews             Json?    // Review[] | null
  // Audiobook series grouping (lib/audiobooks.ts). Null for non-audiobook
  // items. Each standalone audiobook gets its own single-item series so the
  // "up next" lookup always has a key. Episode number lives in the JSON
  // catalog only (data/products.json) for now — it's only used as a tie-break
  // when ordering items within a series, derivable from SKU if absent.
  series              String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // ----- Inventory rotation (lib/inventory.ts) -----
  // Owned by the inventory subsystem. Additive — products-tab agent should
  // leave these alone. All optional/nullable so existing seed/POST flows
  // don't need to set them; null = "behave like the old static catalog".
  //
  // null = unlimited stock (the default for legacy items). Otherwise current
  // on-hand count. decrementStock() enforces non-negative.
  stockQuantity       Int?
  // Availability window. Shape:
  //   { type: 'always' | 'weekly' | 'monthly' | 'dated',
  //     daysOfWeek?: number[],       // 0=Sun..6=Sat, for 'weekly'
  //     weekOfMonth?: number[],      // 1..5, for 'monthly'
  //     featuredDates?: string[] }   // ["MM-DD", ...] — pins to that calendar day
  // Audiobooks and study guides ignore this and are always available
  // (server-enforced in lib/inventory.ts).
  availabilityRule    Json?
  // Auto-restock cadence. Shape:
  //   { cadence: 'mon-thu' | 'weekly' | 'never', amount: number }
  // null = no auto-restock. Hit POST /api/inventory/restock to apply.
  restockSchedule     Json?
  // Stamp from the last successful restock; prevents double-restock on a
  // single calendar day even if the cron runs twice.
  lastRestockAt       DateTime?

  @@index([category])
  @@index([isFeatured])
  @@index([isSale])
  @@map("products")
}

// Kid-submitted feedback. Public POST (rate-limited), parent-gated GET/PUT.
// `page` records the URL the kid was on when they sent it; helpful context
// when triaging ("they hit submit from /shop/checkout").
model Feedback {
  id          String   @id @default(cuid())
  authorName  String?
  // The logged-in user (dl_user) who sent it — stamped ONLY when they provided
  // a name. Blank name = fully anonymous, no identity attached, no reply thread.
  authorUser  String?
  body        String
  page        String?
  userAgent   String?
  status      String   @default("new") // 'new' | 'read' | 'archived'
  // Admin's reply + when it was sent. Null until the admin answers.
  reply       String?
  repliedAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([status, createdAt])
  @@index([authorUser, createdAt])
  @@map("feedback")
}

// Phase 6c — Printable single-use gift cards. Parents mint codes like
// `MP-7K2H9N`, print them, and hand them to a kid for birthdays / surprises.
// One redemption flips the card from unredeemed → redeemed and credits the
// kid via the existing balance.ts `credit()` helper (no second economy).
//
// `code` is the public string shown to humans (including the `MP-` prefix);
// kept as a separate column (not the PK) so we can hold a synthetic cuid id
// for joins later if we ever add per-card audit detail.
model MpGiftCard {
  id             String    @id @default(cuid())
  code           String    @unique // "MP-XXXXXX", 6-char base32 alphabet (no 0/O/1/I/L)
  cents          Int
  createdAt      DateTime  @default(now())
  redeemedByName String?
  redeemedAt     DateTime?
  revoked        Boolean   @default(false)
  note           String?   // parent's optional note ("Happy birthday!")

  @@map("mp_gift_cards")
}

// Kid-to-kid (and admin) MP gifts — a NEW flow distinct from the printable
// single-use MpGiftCard codes. A sender picks a recipient and an amount; the
// MP leaves the sender's balance immediately (admin sends are a free top-up —
// no one is debited). Delivery is either IMMEDIATE (recipient credited now) or
// SCHEDULED for a future `deliverAt` (held until that date, then credited).
//
// No cron on this stack, so delivery is LAZY: deliverDueGifts() in
// lib/money/gift.ts runs on the recipient's balance/portal read path and
// credits any due-but-undelivered gifts. The `delivered` flag is flipped with
// an updateMany guarded on `delivered: false` so a gift can never double-credit
// even under concurrent reads.
model MpGift {
  id            String    @id @default(cuid())
  senderUser    String?   // normalized sender; null = admin (free top-up source)
  recipientUser String    // normalized recipient
  cents         Int       // always positive
  note          String?   // optional sender note ("Happy birthday!")
  deliverAt     DateTime  // when it should arrive (now for immediate)
  delivered     Boolean   @default(false)
  deliveredAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([recipientUser, deliverAt])
  @@index([delivered])
  @@map("mp_gifts")
}

// A family unit — owned by one or more parents (mom AND dad), with invited
// members. Owns its own chore chart. Multi-tenant: different families build
// and edit their own charts, fully isolated. See app/chores/PLAN.md.
//
// `jobs` is the chore catalog for THIS family as a JSON array (FamilyJob[],
// shape in lib/family/types.ts) — same blob pattern as music pieces. Each job
// carries room / frequency / MP / optional assignee / completion history.
//
// `redemptions` is the append-only log of external MP redemptions kids made
// ("movie night – 200MP"), each already debited. Parents read it; no approval.
model Family {
  id          String   @id @default(cuid())
  name        String   // "The Glazier Family"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // Usernames of the parents who manage this family (normalized lowercase).
  // Mirrors DriveUser.isParent — a user must be flagged isParent by Admin AND
  // listed here to manage. Stored as JSON string[] for simple multi-parent.
  parents     Json     @default("[]")
  // The chore catalog (FamilyJob[]). See lib/family/types.ts.
  jobs        Json     @default("[]")
  members     DriveUser[]

  @@map("families")
}

// A kid-filed "I forgot my PIN" request. Non-destructive: filing one NEVER
// touches the account or its progress. The admin sees pending requests on the
// MP Bank dashboard and sets a new PIN; that flips status to 'resolved'. The
// kid then logs in with the PIN the admin gave them and can change it from the
// "Change PIN" spot on the login screen. Replaces the old destructive
// "type reset to wipe" flow.
model PinResetRequest {
  id          String    @id @default(cuid())
  userName    String    // who asked (normalized lowercase) — NOT a FK so a
                        // request survives even if the user row is absent
  status      String    @default("pending") // 'pending' | 'resolved' | 'dismissed'
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([status, createdAt])
  @@map("pin_reset_requests")
}

// Two-device chess match — a shared game row two kids play across separate
// devices/browsers (no websockets/Bluetooth). One creator (white) makes a
// match and gets a short join `code`; the second kid joins as black. The row
// is the single source of truth: each device polls GET to pick up the other's
// moves and POSTs its own via the engine-validated /move endpoint. The server
// re-validates EVERY move with lib/chess/engine — clients are never trusted for
// legality. `version` bumps on each accepted move so a poller can cheaply tell
// "something changed" and skip re-deriving when it hasn't.
//
// MP rewards are intentionally NOT wired for 2-device games yet (would need
// careful per-side attribution to avoid double-credit). See app/chess/play
// PlayMatch + /api/chess/match/[code]/move TODOs.
model ChessMatch {
  id          String   @id @default(cuid())
  code        String   @unique // short readable join code, e.g. "RACE" (no 0/O/1/I/L)
  whiteUser   String?  // creator (normalized dl_user)
  blackUser   String?  // joiner (normalized dl_user)
  moveHistory Json     @default("[]") // string[] of UCI ("e2e4", "e7e8q")
  fen         String   @default("rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1")
  theme       String   @default("classic")
  status      String   @default("waiting") // 'waiting' | 'active' | 'finished'
  turn        String   @default("w")       // 'w' | 'b' — whose move it is
  version     Int      @default(0)         // bumps each accepted move
  result      Json?    // { winner: 'w'|'b'|'draw', reason, finalFen } when finished
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([code])
  @@map("chess_matches")
}

// Append-only redemption log. A kid redeems MP for an external reward; we debit
// immediately (via balance.ts debit) and write one row here so parents can SEE
// what was spent. No approval gate — the real-world OK happens in person.
model Redemption {
  id          String   @id @default(cuid())
  familyId    String
  userName    String   // who redeemed (normalized)
  cents       Int      // amount debited (positive)
  reward      String   // free-form: "Movie night", "$5 cash", ...
  funMessage  String   // the "Have fun!" / "Break a leg!" line shown
  createdAt   DateTime @default(now())

  @@index([familyId, createdAt])
  @@index([userName, createdAt])
  @@map("redemptions")
}
